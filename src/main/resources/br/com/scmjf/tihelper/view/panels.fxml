<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.PanelsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="Painéis" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Atualizar visão" onAction="#refreshPanels" styleClass="primary-button"/>
                        <Button text="Dados mockados" onAction="#showMockNotice" styleClass="secondary-button"/>
                    </children>
                </HBox>

                <FlowPane hgap="14" vgap="14">
                    <children>
                        <VBox spacing="6" prefWidth="210" styleClass="metric-card">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label text="Painéis cadastrados" styleClass="metric-label"/>
                                <Label fx:id="totalPanelsLabel" text="0" styleClass="metric-value"/>
                            </children>
                        </VBox>
                        <VBox spacing="6" prefWidth="210" styleClass="metric-card">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label text="Ligados" styleClass="metric-label"/>
                                <Label fx:id="onlinePanelsLabel" text="0" styleClass="metric-value"/>
                            </children>
                        </VBox>
                        <VBox spacing="6" prefWidth="210" styleClass="warning-card">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label text="Desligados" styleClass="metric-label"/>
                                <Label fx:id="offlinePanelsLabel" text="0" styleClass="metric-value"/>
                            </children>
                        </VBox>
                    </children>
                </FlowPane>

                <TextField fx:id="searchField" promptText="Buscar por painel, IP, local ou status"/>

                <TableView fx:id="panelsTable" prefHeight="460">
                    <columns>
                        <TableColumn fx:id="panelNameColumn" text="Painel"/>
                        <TableColumn fx:id="panelIpColumn" text="IP da máquina"/>
                        <TableColumn fx:id="panelLocationColumn" text="Local"/>
                        <TableColumn fx:id="panelStatusColumn" text="Status"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>
