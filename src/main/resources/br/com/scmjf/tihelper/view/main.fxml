<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="br.com.scmjf.tihelper.controller.MainController"
            styleClass="app-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="app-header">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <children>
                <Label fx:id="screenTitleLabel" text="Dashboard" styleClass="screen-title"/>
                <Label fx:id="screenSubtitleLabel" text="Central de operações" styleClass="screen-subtitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <children>
                        <Label fx:id="loggedUserLabel" text="-" styleClass="user-name"/>
                        <Label fx:id="profileLabel" text="-" styleClass="user-profile"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebar" prefWidth="238" spacing="8" styleClass="sidebar">
            <padding>
                <Insets top="22" right="14" bottom="18" left="14"/>
            </padding>
            <children>
                <Label fx:id="sidebarCaption" text="MENU" styleClass="sidebar-caption"/>
                <Button fx:id="dashboardButton" text="Dashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-button"/>
                <Button fx:id="serversButton" text="Servidores" maxWidth="Infinity" onAction="#showServers" styleClass="nav-button"/>
                <Button fx:id="servicesButton" text="Serviços" maxWidth="Infinity" onAction="#showServices" styleClass="nav-button"/>
                <Button fx:id="queriesButton" text="Queries" maxWidth="Infinity" onAction="#showQueries" styleClass="nav-button"/>
                <Button fx:id="scriptsButton" text="Scripts" maxWidth="Infinity" onAction="#showScripts" styleClass="nav-button"/>
                <Button fx:id="historyButton" text="Histórico" maxWidth="Infinity" onAction="#showHistory" styleClass="nav-button"/>
                <Button fx:id="settingsButton" text="Configurações" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-button"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="logoutButton" text="Sair" maxWidth="Infinity" onAction="#logout" styleClass="logout-button"/>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-host"/>
    </center>
</BorderPane>
