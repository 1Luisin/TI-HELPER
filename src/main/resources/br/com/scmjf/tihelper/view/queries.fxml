<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.QueriesController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <Label text="Queries" styleClass="page-title"/>

                <VBox spacing="10" styleClass="form-panel">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>
                    <children>
                        <Label text="Consulta" styleClass="field-label"/>
                        <ComboBox fx:id="queryCombo" maxWidth="Infinity" onAction="#renderParameters"/>

                        <GridPane fx:id="parametersPane" hgap="14" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="180"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Executar" onAction="#executeQuery" styleClass="primary-button"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label text="Resultado simulado" styleClass="section-title"/>
                <TableView fx:id="resultTable" prefHeight="300" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
