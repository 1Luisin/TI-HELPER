<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.ServicesController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="Serviços" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ver status" onAction="#viewStatus" styleClass="secondary-button"/>
                        <Button fx:id="restartButton" text="Reiniciar" onAction="#restartService" styleClass="primary-button"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <TextField fx:id="searchField" promptText="Buscar por servidor, serviço, descrição ou status" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="feedbackLabel" text="" styleClass="action-feedback"/>
                    </children>
                </HBox>

                <TableView fx:id="servicesTable" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="serverColumn" text="Servidor" prefWidth="130"/>
                        <TableColumn fx:id="nameColumn" text="Nome do serviço" prefWidth="170"/>
                        <TableColumn fx:id="descriptionColumn" text="Descrição" prefWidth="280"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="restartAllowedColumn" text="Reinício" prefWidth="120"/>
                        <TableColumn fx:id="lastCheckColumn" text="Última verificação" prefWidth="170"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>
