<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.ServersController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="Servidores" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="testConnectionButton" text="Testar conexão" onAction="#testConnection" styleClass="primary-button"/>
                        <Button fx:id="viewServicesButton" text="Ver serviços" onAction="#viewServices" styleClass="secondary-button"/>
                        <Button text="Ver busy's produção" onAction="#openProductionBusy" styleClass="secondary-button"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <TextField fx:id="searchField" promptText="Buscar por nome, IP, sistema, ambiente ou status" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="feedbackLabel" text="" styleClass="action-feedback"/>
                    </children>
                </HBox>

                <TableView fx:id="serversTable" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Nome" prefWidth="140"/>
                        <TableColumn fx:id="hostColumn" text="IP/Host" prefWidth="190"/>
                        <TableColumn fx:id="osColumn" text="Sistema operacional" prefWidth="210"/>
                        <TableColumn fx:id="environmentColumn" text="Ambiente" prefWidth="150"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>
