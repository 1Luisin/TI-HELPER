<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.ScriptsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <Label text="Scripts aprovados" styleClass="page-title"/>

                <VBox spacing="14" styleClass="form-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <children>
                        <GridPane hgap="14" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints minWidth="180"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <children>
                                <Label text="Script" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="scriptCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Servidor destino" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="serverTargetField" promptText="Ex.: SRV-APP-01" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Motivo" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextArea fx:id="reasonArea" prefRowCount="4" wrapText="true" promptText="Descreva o motivo da execução simulada" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Executar script" onAction="#executeScript" styleClass="primary-button"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
