<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.SettingsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <Label text="Configurações" styleClass="page-title"/>

                <VBox spacing="16" styleClass="form-panel">
                    <padding>
                        <Insets top="22" right="22" bottom="22" left="22"/>
                    </padding>
                    <children>
                        <Label text="Informações do protótipo" styleClass="section-title"/>
                        <VBox spacing="14">
                            <children>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Usuário logado" styleClass="field-label"/>
                                        <Label fx:id="loggedUserLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4">
                                    <children>
                                        <Label text="Perfil" styleClass="field-label"/>
                                        <Label fx:id="profileLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4">
                                    <children>
                                        <Label text="Versão da aplicação" styleClass="field-label"/>
                                        <Label fx:id="versionLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4">
                                    <children>
                                        <Label text="Ambiente" styleClass="field-label"/>
                                        <Label fx:id="environmentLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
