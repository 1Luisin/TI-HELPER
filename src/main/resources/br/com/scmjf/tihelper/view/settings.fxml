<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scmjf.tihelper.controller.SettingsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-page">
            <padding>
                <Insets top="24" right="26" bottom="26" left="26"/>
            </padding>
            <children>
                <Label text="Configuracoes" styleClass="page-title"/>

                <VBox spacing="16" styleClass="form-panel">
                    <padding>
                        <Insets top="22" right="22" bottom="22" left="22"/>
                    </padding>
                    <children>
                        <Label text="Informacoes do prototipo" styleClass="section-title"/>
                        <FlowPane hgap="42" vgap="14">
                            <children>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Usuario logado" styleClass="field-label"/>
                                        <Label fx:id="loggedUserLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Perfil" styleClass="field-label"/>
                                        <Label fx:id="profileLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Versao da aplicacao" styleClass="field-label"/>
                                        <Label fx:id="versionLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Ambiente" styleClass="field-label"/>
                                        <Label fx:id="environmentLabel" text="-" styleClass="value-label"/>
                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Restaurar mocks" onAction="#restoreDefaultData" styleClass="secondary-button"/>
                                <Button text="Exportar backup" onAction="#exportBackup" styleClass="secondary-button"/>
                                <Button text="Importar backup" onAction="#importBackup" styleClass="secondary-button"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label fx:id="adminAccessLabel"
                       text="Cadastros administrativos disponiveis apenas para usuarios com perfil ADMIN."
                       styleClass="hint-label"/>

                <VBox fx:id="adminPanel" spacing="14">
                    <children>
                        <Label text="Cadastros administrativos" styleClass="section-title"/>
                        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="admin-tabs">
                            <tabs>
                                <Tab text="Servidores">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <FlowPane hgap="12" vgap="10">
                                                            <children>
                                                                <TextField fx:id="serverNameField" promptText="Nome" prefWidth="170"/>
                                                                <TextField fx:id="serverHostField" promptText="IP IPv4" prefWidth="180"/>
                                                                <TextField fx:id="serverOsField" promptText="Sistema operacional" prefWidth="210"/>
                                                                <TextField fx:id="serverEnvironmentField" promptText="Ambiente" prefWidth="150"/>
                                                                <TextField fx:id="serverStatusField" promptText="Status" prefWidth="140"/>
                                                            </children>
                                                        </FlowPane>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearServerFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editServer" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deleteServer" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar servidor" onAction="#addServer" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="serversTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="serverNameColumn" text="Nome"/>
                                                        <TableColumn fx:id="serverHostColumn" text="IP/Host"/>
                                                        <TableColumn fx:id="serverOsColumn" text="Sistema operacional"/>
                                                        <TableColumn fx:id="serverEnvironmentColumn" text="Ambiente"/>
                                                        <TableColumn fx:id="serverStatusColumn" text="Status"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <Tab text="Servicos">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <FlowPane hgap="12" vgap="10">
                                                            <children>
                                                                <TextField fx:id="serviceServerField" promptText="Servidor" prefWidth="170"/>
                                                                <TextField fx:id="serviceNameField" promptText="Nome do servico" prefWidth="210"/>
                                                                <TextField fx:id="serviceStatusField" promptText="Status" prefWidth="150"/>
                                                            </children>
                                                        </FlowPane>
                                                        <TextArea fx:id="serviceDescriptionArea"
                                                                  promptText="Descricao"
                                                                  prefRowCount="3"
                                                                  wrapText="true"/>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearServiceFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editService" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deleteService" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar servico" onAction="#addService" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="servicesTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="serviceServerColumn" text="Servidor"/>
                                                        <TableColumn fx:id="serviceNameColumn" text="Nome"/>
                                                        <TableColumn fx:id="serviceDescriptionColumn" text="Descricao"/>
                                                        <TableColumn fx:id="serviceStatusColumn" text="Status"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <Tab text="Paineis">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <FlowPane hgap="12" vgap="10">
                                                            <children>
                                                                <TextField fx:id="panelNameField" promptText="Nome do painel" prefWidth="210"/>
                                                                <TextField fx:id="panelIpField" promptText="IP da maquina. Ex.: 172.18.x.x" prefWidth="230"/>
                                                                <TextField fx:id="panelLocationField" promptText="Local" prefWidth="190"/>
                                                                <ComboBox fx:id="panelStatusCombo" promptText="Status" prefWidth="150"/>
                                                            </children>
                                                        </FlowPane>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearPanelFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editPanel" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deletePanel" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar painel" onAction="#addPanel" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="panelsTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="panelNameColumn" text="Painel"/>
                                                        <TableColumn fx:id="panelIpColumn" text="IP da maquina"/>
                                                        <TableColumn fx:id="panelLocationColumn" text="Local"/>
                                                        <TableColumn fx:id="panelStatusColumn" text="Status"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <Tab text="Queries">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <TextField fx:id="queryNameField" promptText="Nome da query"/>
                                                        <Label text="Query SQL" styleClass="field-label"/>
                                                        <VBox fx:id="queryEditorHost"
                                                              minHeight="170"
                                                              prefHeight="190"
                                                              styleClass="sql-editor-host"/>
                                                        <CheckBox fx:id="queryHasParametersCheckBox"
                                                                  text="Query com parametros"
                                                                  styleClass="query-parameters-check"/>
                                                        <VBox fx:id="queryParametersBox" spacing="8">
                                                            <children>
                                                                <Label text="Parametros" styleClass="field-label"/>
                                                                <TextField fx:id="queryParametersField"
                                                                           promptText="Parametros separados por virgula. Ex.: CPF, Data inicial"/>
                                                            </children>
                                                        </VBox>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearQueryFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editQuery" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deleteQuery" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar query" onAction="#addQuery" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="queriesTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="queryNameColumn" text="Nome"/>
                                                        <TableColumn fx:id="queryTextColumn" text="Query"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <Tab text="Scripts">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <TextField fx:id="scriptNameField" promptText="Nome do script aprovado"/>
                                                        <TabPane fx:id="scriptSourceTabs"
                                                                 tabClosingPolicy="UNAVAILABLE"
                                                                 styleClass="script-source-tabs">
                                                            <tabs>
                                                                <Tab fx:id="scriptBodyTab" text="Corpo do script">
                                                                    <content>
                                                                        <VBox spacing="8">
                                                                            <children>
                                                                                <Label text="Corpo do script" styleClass="field-label"/>
                                                                                <TextArea fx:id="scriptBodyArea"
                                                                                          promptText="Cole aqui o corpo do script aprovado"
                                                                                          prefRowCount="7"
                                                                                          wrapText="false"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </content>
                                                                </Tab>
                                                                <Tab text="Arquivo">
                                                                    <content>
                                                                        <VBox spacing="8">
                                                                            <children>
                                                                                <Label text="Arquivo do script" styleClass="field-label"/>
                                                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                                                    <children>
                                                                                        <Button text="Selecionar arquivo"
                                                                                                onAction="#chooseScriptFile"
                                                                                                styleClass="secondary-button"/>
                                                                                        <Button text="Limpar arquivo"
                                                                                                onAction="#clearSelectedScriptFile"
                                                                                                styleClass="secondary-button"/>
                                                                                        <Label fx:id="scriptFileLabel"
                                                                                               text="Nenhum arquivo selecionado"
                                                                                               styleClass="script-file-label"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <Label text="O arquivo sera apenas lido e salvo no mock local."
                                                                                       styleClass="hint-label"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </content>
                                                                </Tab>
                                                            </tabs>
                                                        </TabPane>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearScriptFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editScript" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deleteScript" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar script" onAction="#addScript" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="scriptsTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="scriptNameColumn" text="Nome"/>
                                                        <TableColumn fx:id="scriptSourceColumn" text="Origem"/>
                                                        <TableColumn fx:id="scriptSummaryColumn" text="Conteudo / arquivo"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <Tab text="Usuarios">
                                    <content>
                                        <VBox spacing="14">
                                            <padding>
                                                <Insets top="16" right="0" bottom="0" left="0"/>
                                            </padding>
                                            <children>
                                                <VBox spacing="10" styleClass="form-panel">
                                                    <padding>
                                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                                    </padding>
                                                    <children>
                                                        <FlowPane hgap="12" vgap="10">
                                                            <children>
                                                                <TextField fx:id="userNameField" promptText="Login" prefWidth="220"/>
                                                                <PasswordField fx:id="userPasswordField" promptText="Senha" prefWidth="220"/>
                                                                <ComboBox fx:id="userProfileCombo" promptText="Perfil" prefWidth="180"/>
                                                            </children>
                                                        </FlowPane>
                                                        <Label text="Ao editar, deixe a senha em branco para manter a senha atual."
                                                               styleClass="hint-label"/>
                                                        <HBox alignment="CENTER_RIGHT" spacing="8">
                                                            <children>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Button text="Limpar" onAction="#clearUserFields" styleClass="secondary-button"/>
                                                                <Button text="Editar" onAction="#editUser" styleClass="secondary-button"/>
                                                                <Button text="Excluir" onAction="#deleteUser" styleClass="secondary-button"/>
                                                                <Button text="Cadastrar usuario" onAction="#addUser" styleClass="primary-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <TableView fx:id="usersTable" prefHeight="240">
                                                    <columns>
                                                        <TableColumn fx:id="userNameColumn" text="Usuario"/>
                                                        <TableColumn fx:id="userProfileColumn" text="Perfil"/>
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
